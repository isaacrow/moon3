// Looks up each Arabic genre/form term's LCGFT match on id.loc.gov (plan step B2) and writes
// supabase/functions/server/arabicGenres.generated.tsx. Only an exact match of the label LC uses is kept; a term
// with none stays unmapped rather than guessed.
//   npx tsx scripts/arabic-genres.mts
import { writeFileSync } from 'node:fs';
import { ARABIC_GENRES } from '../supabase/functions/server/arabicGenres.tsx';

const out: Record<string, { uri: string; label: string }> = {};
for (const t of ARABIC_GENRES) {
  if (!t.lcgft) continue;
  const url = `https://id.loc.gov/authorities/genreForms/suggest2?q=${encodeURIComponent(t.lcgft)}&searchtype=leftanchored&count=10`;
  const j: any = await (await fetch(url)).json();
  const hit = (j.hits || []).find((h: any) => String(h.aLabel).toLowerCase() === t.lcgft!.toLowerCase());
  if (hit) out[t.id] = { uri: String(hit.uri).replace(/^https:/, 'http:'), label: hit.aLabel };
  console.log(`${t.id.padEnd(18)} ${t.lcgft.padEnd(34)} ${hit ? hit.uri : '— no exact match'}`);
}
writeFileSync('supabase/functions/server/arabicGenres.generated.tsx',
  `// Generated by scripts/arabic-genres.mts: each term's exact LCGFT match, looked up on id.loc.gov.\nexport const LCGFT_MATCHES: Record<string, { uri: string; label: string }> = ${JSON.stringify(out, null, 1)};\n`);
console.log(`${Object.keys(out).length} of ${ARABIC_GENRES.length} terms matched`);
