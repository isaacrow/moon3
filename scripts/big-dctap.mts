/**
 * Copies the BIBFRAME Interoperability Group's monograph DCTAP files (https://github.com/bf-interop/DCTap, CC0)
 * into supabase/functions/server/bigDctap.generated.tsx, so the server checks published records against them
 * (bigShapes.tsx). Run it again to take a newer BIG release:
 *
 *   npx tsx scripts/big-dctap.mts [tag]      (default: the tag below)
 */
import fs from 'node:fs';

const tag = process.argv[2] || 'v0.3.0';
const files = ['Monograph_Work_Text', 'Monograph_Instance_Print', 'Monograph_Instance_Electronic', 'Monograph_AdminMetadata', 'Monograph_Prefixes'];
const out: Record<string, string> = {};
for (const f of files) {
  const url = `https://raw.githubusercontent.com/bf-interop/DCTap/${tag}/Monograph%20DCTAP/${f}.tsv`;
  const r = await fetch(url);
  if (!r.ok) throw new Error(`${url}: ${r.status}`);
  out[f] = (await r.text()).replace(/\r\n/g, '\n');
}
const body = `// Generated by scripts/big-dctap.mts from https://github.com/bf-interop/DCTap (${tag}), CC0 1.0.
// The BIBFRAME Interoperability Group's DCTAP for monographs, kept as published; bigShapes.tsx reads it.
export const BIG_DCTAP_VERSION = ${JSON.stringify(tag)};
export const BIG_DCTAP: Record<string, string> = ${JSON.stringify(out, null, 1)};
`;
fs.writeFileSync('supabase/functions/server/bigDctap.generated.tsx', body);
console.log(`BIG DCTAP ${tag}: ${files.length} files written`);
